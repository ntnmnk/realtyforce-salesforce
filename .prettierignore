{
  "plugins": ["prettier-plugin-apex"],
  "printWidth": 120,
  "tabWidth": 4,
  "useTabs": false,
  "endOfLine": "lf",
  "trailingComma": "none",
  "overrides": [
    {
      "files": "**/*.{cls,trigger,apex}",
      "options": {
        "parser": "apex",
        "apexInsertFinalNewline": true
      }
    },
    {
      "files": "**/lwc/**/*.html",
      "options": {
        "parser": "lwc"
      }
    },
    {
      "files": "*.{cmp,page,component}",
      "options": {
        "parser": "html"
      }
    },
    {
      "files": "*.{json,yaml,yml}",
      "options": {
        "tabWidth": 2
      }
    }
  ]
}